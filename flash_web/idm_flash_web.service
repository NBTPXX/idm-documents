[Unit]
Description=IDM Firmware Flash Web Service
After=network.target network-online.target moonraker.service
Wants=network-online.target

[Service]
Type=simple
User=__FLASH_WEB_USER__
ExecStart=__FLASH_WEB_DIR__/start_systemd.sh
WorkingDirectory=__FLASH_WEB_DIR__
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1
Environment=MOONRAKER_URL=http://localhost:7125
Environment=HOME=__FLASH_WEB_HOME__
Environment=IDM_FW_BASE=__FLASH_WEB_DIR__/..
Environment=IDM_PORT=__FLASH_WEB_PORT__

[Install]
WantedBy=multi-user.target
